# --- StockSentinel config (copy to .env) ---

# Tokenized Stocks API base URL (public, no API key).
# Verified 2026-11-21 from the official docs' cURL example
# (https://docs.base.org/sdks/tokenized-stocks/overview) + live calls.
TS_API_BASE_URL=https://api.coinbase.com/v1/tokenized-stocks

# Public RPC endpoints (defaults are set in src/config.ts; override if rate-limited)
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Polling / engine thresholds
POLL_INTERVAL_MS=600000
DISLOCATION_ALERT_PCT=2.0
NAV_STALE_HOURS=30

# ERC-8056 event radar (D4) — eth_getLogs needs a tolerant RPC; the default
# below (publicnode) handled chunked 300k-block historical scans in testing,
# while mainnet.base.org rate-limited (HTTP 429) on the same scan.
RADAR_RPC_URL=https://base-rpc.publicnode.com
RADAR_BACKFILL_BLOCKS=300000
RADAR_CHUNK_BLOCKS=5000

# Anchor (Base Sepolia) — project-only testnet wallet, NEVER a funded/main wallet.
# Generate a fresh key for this project, fund it from a Base Sepolia faucet.
ANCHOR_PRIVATE_KEY=
SIGNAL_LOG_ADDRESS=

# Optional: ERC-8021 Builder Code for calldata attribution (register at base.dev).
BUILDER_CODE=
